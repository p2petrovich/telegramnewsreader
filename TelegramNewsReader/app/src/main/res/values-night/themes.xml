<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Night mode -->
    <style name="Theme.TelegramNewsReader" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- В ночном режиме по умолчанию используем Purple 200 (более мягкий) -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Статус бар будет темным -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="actionBarStyle">@style/CustomActionBarStyle</item>
    </style>
</resources>
