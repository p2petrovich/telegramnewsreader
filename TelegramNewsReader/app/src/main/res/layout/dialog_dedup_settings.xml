<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dedup_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dedup_description"
        android:textSize="14sp"
        android:textColor="?android:textColorSecondary"
        android:layout_marginBottom="16dp"/>

    <CheckBox
        android:id="@+id/cb_dedup_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dedup_enable"
        android:checked="true"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dedup_threshold_label"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dedup_threshold_hint"
        android:textSize="12sp"
        android:textColor="?android:textColorSecondary"
        android:layout_marginBottom="8dp"/>

    <SeekBar
        android:id="@+id/sb_dedup_threshold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="90"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tv_dedup_threshold_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="90%"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dedup_history_label"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dedup_history_hint"
        android:textSize="12sp"
        android:textColor="?android:textColorSecondary"
        android:layout_marginBottom="8dp"/>

    <SeekBar
        android:id="@+id/sb_dedup_history_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="1000"
        android:progress="500"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tv_dedup_history_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="500 сообщений"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dedup_time_label"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dedup_time_hint"
        android:textSize="12sp"
        android:textColor="?android:textColorSecondary"
        android:layout_marginBottom="8dp"/>

    <SeekBar
        android:id="@+id/sb_dedup_time_window"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="24"
        android:progress="1"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tv_dedup_time_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1 час"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

</LinearLayout>