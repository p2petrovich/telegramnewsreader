<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground">

    <!-- Заголовок голоса с иконкой и кнопкой воспроизведения -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 🔥 НОВОЕ: Иконка пола -->
        <TextView
            android:id="@+id/tvGenderIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👨"
            android:textSize="20sp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <RadioButton
            android:id="@+id/radioVoice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Голос"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Прослушать голос"
            android:src="@android:drawable/ic_media_play"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="?android:attr/colorAccent" />
    </LinearLayout>

    <!-- Контролы тембра и скорости -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <!-- Тембр -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Тембр"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary" />

            <SeekBar
                android:id="@+id/seekPitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="100"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tvPitchValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="1.0"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center" />

            <!-- 🔥 НОВОЕ: Кнопка сброса тембра -->
            <ImageButton
                android:id="@+id/btnResetPitch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Сброс тембра"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Скорость -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Скорость"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary" />

            <SeekBar
                android:id="@+id/seekRate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="100"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tvSpeedValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="1.0"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center" />

            <!-- 🔥 НОВОЕ: Кнопка сброса скорости -->
            <ImageButton
                android:id="@+id/btnResetRate"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Сброс скорости"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Разделитель -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="?android:attr/listDivider" />
</LinearLayout>