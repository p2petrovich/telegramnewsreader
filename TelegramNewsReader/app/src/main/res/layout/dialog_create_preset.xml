<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preset_dialog_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/preset_name_label"
        android:textSize="14sp"
        android:textColor="?android:textColorSecondary" />

    <EditText
        android:id="@+id/et_preset_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/preset_name_hint"
        android:inputType="text"
        android:maxLength="40"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/preset_period_label"
        android:textSize="14sp"
        android:textColor="?android:textColorSecondary"
        android:layout_marginTop="12dp" />

    <Spinner
        android:id="@+id/spinner_preset_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tv_selected_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="13sp"
        android:textColor="?android:textColorSecondary" />

</LinearLayout>