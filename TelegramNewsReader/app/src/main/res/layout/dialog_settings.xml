<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Настройки"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:textColor="?attr/colorOnSurface" />

    <Button
        android:id="@+id/btn_manage_hidden"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Управление скрытыми каналами"
        android:layout_marginBottom="8dp"
        style="@style/Widget.Material3.Button" />

    <Button
        android:id="@+id/btn_voice_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Голос и речь"
        android:layout_marginBottom="8dp"
        style="@style/Widget.Material3.Button" />

    <Button
        android:id="@+id/btn_clear_cache"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Очистить кэш аудио"
        android:layout_marginBottom="8dp"
        style="@style/Widget.Material3.Button" />

    <Button
        android:id="@+id/btn_reset_auth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сбросить авторизацию"
        android:layout_marginBottom="8dp"
        style="@style/Widget.Material3.Button" />

    <Button
        android:id="@+id/btn_about"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="О программе"
        style="@style/Widget.Material3.Button" />

</LinearLayout>
