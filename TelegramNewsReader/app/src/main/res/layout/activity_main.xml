<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_select_channels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_channels"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_channels"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btn_manage_hidden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Управление скрытыми каналами"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tv_time_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/time_period"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/spinner_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:spinnerMode="dropdown"
            android:popupBackground="@drawable/bg_spinner_popup" />

        <Button
            android:id="@+id/btn_collect_news"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/collect_news"
            android:layout_marginTop="16dp" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:layout_gravity="center_horizontal" />

        <!-- ПАНЕЛЬ ПЛЕЕРА: 4 кнопки-иконки -->
        <LinearLayout
            android:id="@+id/ll_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:weightSum="4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_play"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text=""
                android:contentDescription="@string/play"
                app:icon="@drawable/ic_play"
                app:iconSize="24dp"
                app:iconPadding="0dp"
                app:iconGravity="textStart"
                app:cornerRadius="24dp"
                app:iconTint="@color/white"
                app:backgroundTint="@color/purple_500" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pause"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text=""
                android:contentDescription="@string/pause"
                app:icon="@drawable/ic_pause"
                app:iconSize="24dp"
                app:iconPadding="0dp"
                app:iconGravity="textStart"
                app:cornerRadius="24dp"
                app:iconTint="@color/white"
                app:backgroundTint="@color/purple_500" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text=""
                android:contentDescription="@string/stop"
                app:icon="@drawable/ic_stop"
                app:iconSize="24dp"
                app:iconPadding="0dp"
                app:iconGravity="textStart"
                app:cornerRadius="24dp"
                app:iconTint="@color/white"
                app:backgroundTint="@color/purple_500" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text=""
                android:contentDescription="@string/next"
                app:icon="@drawable/ic_next"
                app:iconSize="24dp"
                app:iconPadding="0dp"
                app:iconGravity="textStart"
                app:cornerRadius="24dp"
                app:iconTint="@color/white"
                app:backgroundTint="@color/purple_500" />
        </LinearLayout>

        <!-- Новое: строка прогресса воспроизведения -->
        <TextView
            android:id="@+id/tv_playing_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btn_open_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Голос и речь"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btn_reset_auth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сбросить авторизацию"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>