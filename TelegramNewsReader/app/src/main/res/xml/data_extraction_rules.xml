<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="device.xml"/>
        <!-- ✅ ИСПРАВЛЕНО: добавлено расширение .db к имени базы данных -->
        <exclude domain="database" path="news_database.db"/>
    </cloud-backup>
    <!-- ✅ ДОБАВЛЕНО: раздел device-transfer для передачи между устройствами -->
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="device.xml"/>
        <!-- ✅ ИСПРАВЛЕНО: добавлено расширение .db к имени базы данных -->
        <exclude domain="database" path="news_database.db"/>
    </device-transfer>
</data-extraction-rules>